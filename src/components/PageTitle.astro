---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { getTopicConnections } from '../lib/topics';

const { entry, locale } = Astro.locals.starlightRoute;
const { concept, quizTopic, verified } = await getTopicConnections(entry, locale);
const { t } = Astro.locals;
---

{
	concept && (
		<p class="topic-parent">
			{t('topic.partOf')} <a href={concept.href}>{concept.title}</a>
		</p>
	)
}
{
	quizTopic && (
		<p class="topic-parent">
			{t('topic.quizFor')} <a href={quizTopic.href}>{quizTopic.title}</a>
		</p>
	)
}
<Default />
{
	verified && (
		<p class="topic-verified">
			{t('topic.checkedAgainst')}{' '}
			{Object.entries(verified.versions).map(([tool, version]) => (
				<code>
					{tool} {version}
				</code>
			))}{' '}
			· {verified.date.toISOString().slice(0, 10)}
		</p>
	)
}
