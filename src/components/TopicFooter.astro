---
import { LinkButton } from '@astrojs/starlight/components';
import { getTopicConnections, type TopicLink } from '../lib/topics';

const { entry, locale } = Astro.locals.starlightRoute;
const { concept, related, linkedFrom, quiz, officialDocs } = await getTopicConnections(entry, locale);
const relatedTopics: TopicLink[] = concept ? [concept, ...related] : related;
const { t } = Astro.locals;
---

{
	quiz && (
		<div class="topic-quiz">
			<p>{t('topic.quizPrompt')}</p>
			<LinkButton href={quiz.href} icon="right-arrow">
				{t('topic.quizButton')}
			</LinkButton>
		</div>
	)
}
{
	officialDocs.length > 0 && (
		<section class="topic-links">
			<h2>{t('topic.officialDocs')}</h2>
			<ul>
				{officialDocs.map((doc) => (
					<li>
						<a href={doc.url} target="_blank" rel="noopener">
							{doc.title}
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}
{
	relatedTopics.length > 0 && (
		<section class="topic-links">
			<h2>{t('topic.related')}</h2>
			<ul>
				{relatedTopics.map((topic) => (
					<li>
						<a href={topic.href}>{topic.title}</a>
					</li>
				))}
			</ul>
		</section>
	)
}
{
	linkedFrom.length > 0 && (
		<section class="topic-links">
			<h2>{t('topic.linkedFrom')}</h2>
			<ul>
				{linkedFrom.map((topic) => (
					<li>
						<a href={topic.href}>{topic.title}</a>
					</li>
				))}
			</ul>
		</section>
	)
}
